# 复制为 .env.local 后填入自己的本地 MySQL 连接；该文件不进入源码分享包。
APP_ENV=local
HTTP_ADDR=127.0.0.1:18090
STORE_ID=1
MYSQL_DSN=campus:replace-local-password@tcp(127.0.0.1:3307)/campus_retail_test?parseTime=true&loc=UTC&charset=utf8mb4&multiStatements=true
JWT_SECRET=replace-with-your-own-random-local-secret-32-bytes
ACCESS_TOKEN_TTL=8h
AUTO_MIGRATE=false
MIGRATIONS_DIR=../db/migrations
PAYMENT_MODE=simulated
SEED_DEMO=false
DEMO_PASSWORD=replace-local-demo-password
OSS_DIR=./data/uploads
