page {
  background: #f5f6f7;
  color: #202520;
  font-size: 28rpx;
  -webkit-font-smoothing: antialiased;
}
view, text, button, input, select, textarea { box-sizing: border-box; }
.btn {
  margin: 0;
  padding: 0 28rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 16rpx;
  background: #ffd84d;
  color: #202520;
  font-size: 26rpx;
  font-weight: 700;
}
.btn::after { border: none; }
.btn.ghost { background: #eef0ec; color: #202520; }
.btn.danger { background: #fff1ed; color: #bb3a2a; }
.btn[disabled] { opacity: .5; }
.card {
  background: #fff;
  border: 1rpx solid #e4e6e2;
  border-radius: 24rpx;
  padding: 24rpx;
  margin: 0 24rpx 20rpx;
}
.row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.muted { color: #70766f; font-size: 22rpx; }
.money { font-weight: 700; }
.badge {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  background: #eef0ec;
  color: #596057;
  margin-left: 10rpx;
}
.badge.good { background: #edf7f1; color: #2e7d5b; }
.badge.warn { background: #fff6d8; color: #7a5a00; }
.badge.danger { background: #fff1ed; color: #bb3a2a; }
.input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  border: 1rpx solid #e4e6e2;
  border-radius: 14rpx;
  background: #fbfcfa;
  margin-top: 10rpx;
}
.field { margin-bottom: 20rpx; font-size: 24rpx; color: #70766f; }
.empty { padding: 120rpx 24rpx; text-align: center; color: #70766f; }
.notice { margin: 20rpx 24rpx; padding: 18rpx 22rpx; border-radius: 14rpx; background: #fff6d8; color: #7a5a00; font-size: 24rpx; }
.notice.danger { background: #fff1ed; color: #bb3a2a; }
.page-pad { padding-bottom: 140rpx; }
