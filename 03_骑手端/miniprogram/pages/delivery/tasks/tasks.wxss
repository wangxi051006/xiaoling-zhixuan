.head { display: flex; justify-content: space-between; align-items: center; padding: 28rpx 28rpx 10rpx; }
.title { font-size: 42rpx; font-weight: 800; letter-spacing: -1rpx; }
.small-btn { margin: 0; padding: 0 20rpx; height: 60rpx; line-height: 60rpx; font-size: 22rpx; border-radius: 10rpx; background: #eef0ec; }
.section { padding: 24rpx 28rpx 12rpx; font-weight: 700; color: #70766f; font-size: 24rpx; }
.no { font-weight: 800; font-size: 28rpx; }
.card .btn { width: 100%; margin-top: 12rpx; }
.link { color: #2d5b9e; font-size: 22rpx; }
