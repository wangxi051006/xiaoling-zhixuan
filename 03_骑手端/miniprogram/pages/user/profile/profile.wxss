.me { display: flex; align-items: center; gap: 20rpx; }
.avatar { width: 96rpx; height: 96rpx; border-radius: 50%; background: #202520; color: #ffd84d; text-align: center; line-height: 96rpx; font-size: 40rpx; font-weight: 800; }
.name { font-size: 32rpx; font-weight: 800; }
.menu { display: flex; justify-content: space-between; align-items: center; font-size: 26rpx; }
.tip { padding: 0 32rpx; line-height: 1.6; }
