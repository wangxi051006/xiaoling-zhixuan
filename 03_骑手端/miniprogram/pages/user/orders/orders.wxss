.order { display: flex; flex-direction: column; gap: 12rpx; }
.no { font-weight: 800; font-size: 28rpx; }
.money { font-weight: 800; font-size: 30rpx; }
.first { padding: 12rpx 16rpx; background: #fff8dd; border: 1rpx solid #ecc33f; border-radius: 10rpx; font-size: 22rpx; color: #6f5100; }
.link { color: #2d5b9e; font-size: 22rpx; }
.retry { color: #bb3a2a; text-decoration: underline; }
