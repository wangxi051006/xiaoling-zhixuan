.no { font-weight: 800; font-size: 30rpx; }
.first { margin: 14rpx 0; padding: 12rpx 16rpx; background: #fff8dd; border: 1rpx solid #ecc33f; border-radius: 10rpx; font-size: 22rpx; color: #6f5100; }
.h { font-weight: 700; margin-bottom: 12rpx; }
.line { display: flex; justify-content: space-between; padding: 12rpx 0; border-bottom: 1rpx solid #f0f2ee; font-size: 24rpx; }
.total { margin-top: 12rpx; padding-top: 14rpx; border-top: 1rpx dashed #e4e6e2; font-weight: 800; font-size: 30rpx; }
.event { display: flex; justify-content: space-between; padding: 10rpx 0; font-size: 22rpx; border-bottom: 1rpx solid #f0f2ee; }
.card .btn { margin-top: 12rpx; }
.sim { background: #fff9e3; border-color: #ecd06b; }
.warn-title { font-weight: 700; color: #7a5a00; margin-bottom: 6rpx; }
.code { margin-top: 16rpx; text-align: center; font-size: 56rpx; letter-spacing: 16rpx; font-weight: 800; }
.urge-ok { color: #2e7d5b; font-size: 22rpx; margin-top: 8rpx; }
.urge-reason { color: #bb3a2a; font-size: 22rpx; margin-top: 8rpx; }
.urge-form { margin-top: 12rpx; }
.urge-form .btn { margin-top: 8rpx; }
.urge-record { margin-top: 12rpx; padding: 12rpx 14rpx; background: #fafbf8; border: 1rpx solid #eef0ec; border-radius: 10rpx; font-size: 22rpx; }
.urge-record .badge { margin-left: 8rpx; }
.small { font-size: 20rpx; }
.block { margin: 24rpx; }
