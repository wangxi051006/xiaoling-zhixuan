<view class="page-pad"><view class="title">站内消息 · {{notificationUnread}} 条未读</view><view wx:if="{{error}}" class="notice danger">{{error}}</view><view wx:if="{{!notifications.length}}" class="empty">暂无消息</view><view wx:for="{{notifications}}" wx:key="id" class="card"><view class="row"><text class="h">{{item.title}}</text><text wx:if="{{!item.readAt}}" class="badge warn">未读</text></view><view>{{item.body}}</view><view class="muted">{{item.createdAt}}</view><view class="row"><button class="small-btn" data-id="{{item.id}}" data-order="{{item.orderId}}" bindtap="open">查看订单</button><button wx:if="{{!item.readAt}}" class="small-btn" data-id="{{item.id}}" bindtap="read">标为已读</button></view></view></view>
