.login { min-height: 100vh; background: #202520; }
.hero { padding: 120rpx 48rpx 60rpx; color: #fff; }
.logo { width: 96rpx; height: 96rpx; border-radius: 28rpx; background: #ffd84d; color: #202520; font-size: 48rpx; font-weight: 800; text-align: center; line-height: 96rpx; }
.title { margin-top: 28rpx; font-size: 60rpx; font-weight: 800; letter-spacing: 2rpx; }
.sub { margin-top: 8rpx; color: #bfc6bf; font-size: 26rpx; }
.form { background: #fff; border-radius: 36rpx 36rpx 0 0; padding: 44rpx 40rpx 80rpx; min-height: 60vh; }
.btn { width: 100%; margin-top: 12rpx; }
.demo { margin-top: 40rpx; }
.demo-title { color: #70766f; font-size: 24rpx; margin-bottom: 16rpx; }
.demo-row { display: flex; gap: 16rpx; flex-wrap: wrap; }
.mini { margin: 0; padding: 0 20rpx; height: 60rpx; line-height: 60rpx; font-size: 22rpx; border-radius: 10rpx; background: #eef0ec; }
.fine { margin-top: 24rpx; color: #9aa19a; font-size: 20rpx; line-height: 1.6; }
