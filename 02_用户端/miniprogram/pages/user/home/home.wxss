.hero { background: linear-gradient(120deg, #fff1ad, #ffd84d 60%, #ffcf2a); padding: 40rpx 32rpx 30rpx; border-radius: 0 0 36rpx 36rpx; }
.eyebrow { font-size: 18rpx; letter-spacing: 2rpx; color: #6f5b12; }
.title { font-size: 48rpx; font-weight: 800; letter-spacing: -1rpx; margin-top: 8rpx; }
.sub { font-size: 22rpx; color: #6f5b12; margin-top: 4rpx; }
.avatar { width: 76rpx; height: 76rpx; border-radius: 50%; background: #202520; color: #ffd84d; text-align: center; line-height: 76rpx; font-weight: 800; }
.hero-actions { margin-top: 28rpx; }
.quick { background: rgba(255,255,255,.65); border-radius: 999rpx; padding: 10rpx 20rpx; font-size: 22rpx; }
.search-box { padding: 24rpx; }
.search-box input { background: #fff; border: 1rpx solid #e4e6e2; border-radius: 16rpx; height: 76rpx; padding: 0 22rpx; }
.cats { white-space: nowrap; padding: 0 24rpx 10rpx; }
.cat { display: inline-block; padding: 10rpx 22rpx; margin-right: 12rpx; border-radius: 999rpx; background: #fff; border: 1rpx solid #e4e6e2; font-size: 22rpx; }
.cat.active { background: #202520; color: #fff; border-color: #202520; }
.grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; padding: 8rpx 24rpx 20rpx; }
.product { background: #fff; border: 1rpx solid #e4e6e2; border-radius: 22rpx; padding: 20rpx; }
.emoji { height: 100rpx; border-radius: 14rpx; background: #fff7d1; text-align: center; line-height: 100rpx; font-size: 52rpx; }
.pname { margin-top: 12rpx; font-weight: 700; font-size: 26rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.pspec { margin-top: 4rpx; font-size: 20rpx; }
.pfoot { margin-top: 10rpx; }
.money { font-size: 30rpx; font-weight: 800; }
.add { width: 54rpx; height: 54rpx; line-height: 54rpx; padding: 0; border-radius: 50%; background: #ffd84d; font-size: 30rpx; font-weight: 800; }
.add[disabled] { background: #eef0ec; color: #9aa19a; }
.cartbar { position: fixed; left: 24rpx; right: 24rpx; bottom: calc(20rpx + env(safe-area-inset-bottom)); background: #fff; border: 1rpx solid #e4e6e2; box-shadow: 0 12rpx 30rpx rgba(32,37,32,.14); border-radius: 20rpx; padding: 14rpx 18rpx; display: flex; align-items: center; justify-content: space-between; }
.cart-title { font-weight: 700; margin-right: 12rpx; }
.retry { color: #bb3a2a; text-decoration: underline; }
